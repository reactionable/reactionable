{
	"name": "root",
	"private": true,
	"scripts": {
		"start": "lerna run --parallel start --",
		"test": "lerna run --stream test --",
		"test:ci": "lerna run --stream test:coverage --",
		"lint": "lerna run --stream lint --",
		"lint:ci": "lerna run --stream lint:ci --",
		"build": "lerna run --stream build --",
		"build:ci": "lerna run --stream build:ci --",
		"build:all": "npm run build:ci && npm run docs:build && npm run storybook:build",
		"link": "node dev-link link",
		"unlink": "node dev-link unlink",
		"docs:build": "lerna run --stream build:docs",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "npm run build-storybook -- -o build/storybook",
		"prepare": "ts-dev-tools install",
		"ci": "npm run lint && npm run build:all && npm run test:ci",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.0",
		"@commitlint/config-nx-scopes": "^21.2.0",
		"@jridgewell/gen-mapping": "^0.3.13",
		"@storybook/addon-docs": "^10.5.8",
		"@storybook/addon-links": "^10.5.8",
		"@storybook/addon-onboarding": "^10.5.8",
		"@storybook/react": "^10.5.8",
		"@storybook/react-vite": "^10.5.8",
		"@ts-dev-tools/react": "^1.11.1",
		"barrelsby": "^2.8.1",
		"lerna": "^10.0.0",
		"nx": "^23.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remark-gfm": "^4.0.1",
		"rimraf": "^6.1.3",
		"storybook": "^10.5.7",
		"typedoc": "^0.28.20",
		"vite": "^8.2.1"
	},
	"overrides": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"workspaces": [
		"packages/*"
	],
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional",
			"@commitlint/config-nx-scopes"
		]
	},
	"tsDevTools": {
		"version": "20260604100001-migrate-to-vitest"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"unrs-resolver@1.11.1": true,
		"nx@23.1.1": true
	}
}
