{
	"name": "@reactionable/react-router",
	"version": "0.28.31",
	"description": "Reactionable Router package for react-router",
	"files": [
		"lib"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"main": "lib/index.js",
	"typings": "lib/index.d.ts",
	"scripts": {
		"start": "npm run build:barrelsby && tsc --watch --outDir lib/",
		"test": "vitest run --config ../../vitest.config.mts src",
		"test:coverage": "vitest run --config ../../vitest.config.mts --coverage src",
		"build:pre": "npm run build:clean && npm run build:barrelsby",
		"build": "npm run build:pre && npm run build:lib",
		"build:ci": "npm run build:pre && npm run build:lib",
		"build:clean": "rimraf lib",
		"build:barrelsby": "npm exec barrelsby -- --noHeader -d src --exclude \".+\\.test\\..+\" --exclude \".+\\.stories\\..+\" --exclude \".+/__mocks__/.+\" --delete -q && npm exec prettier -- --write src/index.ts",
		"build:lib": "tsc --pretty -p tsconfig.build.json --outDir lib/",
		"build:docs": "typedoc --tsconfig tsconfig.build.json",
		"lint": "biome lint --error-on-warnings .",
		"lint:ci": "biome lint --error-on-warnings --reporter=json-pretty . > biome-report.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reactionable/reactionable.git"
	},
	"keywords": [
		"reactionable",
		"react",
		"framework",
		"Router",
		"react-router"
	],
	"author": "ESCEMI <developer@escemi.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/reactionable/reactionable/issues"
	},
	"homepage": "https://github.com/reactionable/reactionable#readme",
	"dependencies": {
		"@reactionable/core": "^0.28.31",
		"react-helmet": "^6.1.0",
		"react-router": "^8.3.0"
	},
	"devDependencies": {
		"@types/react-helmet": "^6.1.6"
	},
	"publishConfig": {
		"access": "public"
	}
}
