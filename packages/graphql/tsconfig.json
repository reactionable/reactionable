{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"customConditions": ["module-sync"],
		"rootDir": "src",
		"outDir": "lib",
		"declarationDir": "lib"
	},
	"include": ["src"],
	"typedocOptions": {
		"out": "../../build/storybook/docs/graphql",
		"entryPoints": ["src/index.ts"],
		"hideGenerator": true,
		"githubPages": true,
		"includeVersion": true,
		"readme": "none",
		"excludeExternals": true,
		"excludePrivate": true
	}
}
